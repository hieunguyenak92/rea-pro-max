{
  "name": "rea-pro-max",
  "version": "0.2.0",
  "private": true,
  "description": "Independent reverse-engineering MCP, skill and CLI: artifact boundaries, distinguishing experiments and finite behavioral verification.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rea-pro-max": "skills/rea-pro-max/scripts/rea-pro-max.mjs",
    "rea-pro-max-mcp": "skills/rea-pro-max/scripts/mcp-server.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint .",
    "check:docs": "node tools/check-docs.mjs",
    "demo": "node skills/rea-pro-max/scripts/rea-pro-max.mjs demo --out ./rpm-lab",
