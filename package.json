    "build:demo": "node tools/build-demo.mjs",
    "vendor:mcp": "node tools/vendor-mcp.mjs",
    "check:vendor": "node tools/vendor-mcp.mjs --check",
    "check:mcp": "node tools/check-mcp.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "electron": "45.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
