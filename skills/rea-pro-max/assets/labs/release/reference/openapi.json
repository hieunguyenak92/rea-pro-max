{
  "openapi": "3.1.0",
  "info": {
    "title": "Owned catalog fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/items/{itemId}": {
      "get": {
        "parameters": [
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "One item" } }
      },
      "delete": {
        "parameters": [
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/items/search": {
      "get": { "responses": { "200": { "description": "Results" } } }
    }
  }
}
